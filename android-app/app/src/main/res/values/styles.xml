<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#080F1C</item>
        <item name="android:colorBackground">#080F1C</item>
        <item name="android:colorPrimary">#111D30</item>
        <item name="android:colorPrimaryDark">#080F1C</item>
        <item name="android:colorAccent">#4CE0D6</item>
        <item name="android:colorControlNormal">#98ABC3</item>
        <item name="android:colorControlActivated">#4CE0D6</item>
        <item name="android:colorControlHighlight">#244CE0D6</item>
        <item name="android:colorButtonNormal">#20354B</item>
        <item name="android:textColorPrimary">#F4F7FF</item>
        <item name="android:textColorSecondary">#98ABC3</item>
        <item name="android:textColorHint">#71859F</item>
        <item name="android:textColorLink">#4CE0D6</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#080F1C</item>
        <item name="android:navigationBarColor">#080F1C</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:alertDialogTheme">@style/DianaDialogTheme</item>
        <item name="android:buttonStyle">@style/DianaButton</item>
        <item name="android:buttonBarButtonStyle">@style/DianaDialogButton</item>
    </style>

    <style name="DianaButton" parent="android:style/Widget.Material.Button">
        <item name="android:textColor">#F4F7FF</item>
        <item name="android:backgroundTint">#20354B</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="DianaDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#4CE0D6</item>
        <item name="android:colorBackground">#111D30</item>
        <item name="android:windowBackground">@drawable/bg_ui_dialog</item>
        <item name="android:textColorPrimary">#F4F7FF</item>
        <item name="android:textColorSecondary">#98ABC3</item>
        <item name="android:textColorLink">#4CE0D6</item>
        <item name="android:buttonBarButtonStyle">@style/DianaDialogButton</item>
    </style>

    <style name="DianaDialogButton" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">#4CE0D6</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
    </style>
</resources>
