# npm run setup generates three different random tokens locally.
USER_TOKEN=
AGENT_TOKEN=
GATEWAY_TOKEN=
DEVICE_ID=home-pc
HOST=127.0.0.1
PORT=3411
API_BASE_URL=http://127.0.0.1:3411
APP_ORIGIN=http://127.0.0.1:3411
DOCUMENT_ROOT=./sample-documents

# Render Free persistence (server only): leave all three empty for local SQLite.
# For Supabase, use the IPv4-compatible Session Pooler connection URI from Connect.
# URL-encode special characters in the database password. Never commit real keys.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=diana-transfers

# lexical is a local keyword demo, not AI. openai/groq sends bounded document
# excerpts to the selected provider. Configure that provider before enabling it.
AI_MODE=lexical
OPENAI_API_KEY=
OPENAI_MODEL=
# For Groq set AI_MODE=groq. GROQ_OPENAI_KEY is also accepted as a key alias.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Overnight review always requires a real API configuration; lexical is not used.
# Optional bundled presentation runtime locations (auto-detected in Codex).
RUNTIME_NODE_MODULES=
RUNTIME_NODE=
RUNTIME_PYTHON=
PRESENTATIONS_SKILL_DIR=
PRESENTATION_FONT=Malgun Gothic

# No actual email is sent by default. See docs/메일연결.md.
MAIL_MODE=dry-run
MAIL_PROVIDER=custom
MAIL_AUTH=password
MAIL_FROM=demo@example.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_ACCESS_TOKEN=

# Gateway runs on an always-on device in the PC's LAN, not the target PC.
PC_MAC=
WOL_BROADCAST=255.255.255.255
WOL_PORT=9
WAKE_DRY_RUN=true
