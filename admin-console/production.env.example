# Preparation template only. Not loaded by server.mjs or any deployment.
# Keep disabled until the separate production adapter and runtime wiring are reviewed.
DIANA_ADMIN_ENABLED=false
# Actual administrator HTTPS origin and exact RP hostname: intentionally undecided.
DIANA_ADMIN_ORIGIN=
DIANA_ADMIN_RP_ID=
# Dedicated authentication DB credentials, not the existing app DATABASE_URL.
# Store the real URL only in the deployment secret store; never commit it.
DIANA_ADMIN_DATABASE_URL=
DIANA_ADMIN_DATABASE_NAME=
DIANA_ADMIN_DATABASE_SCHEMA=diana_admin_prod_v1
# Explicit choice: verified-tls or render-private. No sslmode URL overrides.
DIANA_ADMIN_DATABASE_TRANSPORT=
# Only for render-private: exact verified production DB internal hostname.
DIANA_ADMIN_PRIVATE_DATABASE_HOST=
# Explicitly verified immediate proxy IPs, comma separated; never * or 0.0.0.0/0.
DIANA_ADMIN_TRUSTED_PROXY_IPS=
